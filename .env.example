# Know Your Agent - Environment Variables

# App Config
PROJECT_NAME="Know Your Agent - Fraud Detection Layer"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="kya_super_secret_key_change_in_production"

# Database Configuration
# For Docker Compose: postgresql+asyncpg://kya_user:kya_password@db:5432/kya_db
# For SQLite Fallback: sqlite+aiosqlite:///./kya_dev.db
DATABASE_URL="sqlite+aiosqlite:///./kya_dev.db"

# Risk Scoring Thresholds
HARD_AMOUNT_LIMIT=1000.00
VELOCITY_WINDOW_MINUTES=5
MAX_ACTIONS_PER_WINDOW=5
ANOMALY_SCORE_THRESHOLD=65.0

# Service URLs (for Streamlit dashboard and simulator)
API_BASE_URL="http://localhost:8000"
